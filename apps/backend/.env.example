# apps/backend/.env.example
# Copy these environment variables into your Railway Dashboard settings

# Service Port (Railway injects this automatically)
PORT=3000
NODE_ENV=production

# Supabase Cloud PostgreSQL (Transaction Pooler port 6543)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase Cloud PostgreSQL Direct (Session migration port 5432)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# JWT Authentication
JWT_ACCESS_SECRET="generate_a_secure_random_64_char_secret_for_production_access"
JWT_REFRESH_SECRET="generate_a_secure_random_64_char_secret_for_production_refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS Allowed Origins
CORS_ORIGIN="https://your-hospital-frontend.vercel.app,http://localhost:3000,http://localhost:8080"

# Supabase Storage & Services (Optional for file signed URLs)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
